    "twitter": "https://twitter.com/core_ui"
  },
  "contributors": [
    {
      "name": "CoreUI Core Team",
      "url": "https://github.com/orgs/coreui/people"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coreui/coreui-free-bootstrap-admin-template.git"
  },
  "funding": [
    {
      "type": "opencollective",
      "url": "https://opencollective.com/coreui"
    },
    {
      "type": "subscription",
      "url": "https://coreui.io/pricing/?framework=bootstrap"
    }
  ],
  "scripts": {
    "build": "npm run clean && npm run css && npm run runtime && npm run verify",
    "clean": "rimraf dist",
    "css": "npm run css-compile && npm run css-prefix && npm run css-minify && npm run css-clean",
    "css-compile": "sass --style expanded --no-source-map --no-error-css --load-path=node_modules/ src/scss/style.scss dist/css/style.css",
    "css-prefix": "postcss --config build/postcss.config.mjs --replace dist/css/style.css",
    "css-minify": "cleancss -O1 --format breakWith=lf --with-rebase --output dist/css/style.min.css dist/css/style.css",
    "css-clean": "rimraf dist/css/style.css",
    "runtime": "node build/runtime-assets.mjs copy",
    "verify": "node build/runtime-assets.mjs verify",
    "verify-vendor": "node build/runtime-assets.mjs verify-vendor"
  },
  "dependencies": {
    "@coreui/coreui": "5.9.0",
    "simplebar": "6.3.3"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.4",
    "clean-css-cli": "^5.6.3",
    "postcss": "^8.5.26",
    "postcss-cli": "^11.0.1",
    "postcss-combine-duplicated-selectors": "^10.0.3",
    "postcss-drop-empty-css-vars": "^0.0.0",
    "rimraf": "^6.1.3",
    "sass": "1.102.0"
  }
}
